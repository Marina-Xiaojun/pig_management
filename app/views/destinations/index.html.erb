<div class="destination-list-background">
  <div class="destination-page">
    <h1>出荷先一覧</h1>

    <%= link_to "出荷先を新規登録", destinations_new_path %>

      <% if alert %>
        <p class="delete-error"><%= alert %></p>
      <% end %>

    <% if @destinations.any? %>
      <% @destinations.each do |destination| %>

        <div class="destination-actions">
          <span><%= destination.name %></span>

          <%= link_to "編集", edit_destination_path(destination) %>

          <%= button_to "削除",
              destination_path(destination),
              method: :delete,
              data: {
                turbo_confirm: "【注意】出荷記録で使用されている出荷先は削除できません。本当に削除しますか？"
              } %>
        </div>

      <% end %>
    <% else %>
      <p>まだ登録されていません。</p>
    <% end %>

    <%= notice %>
  </div>
</div>