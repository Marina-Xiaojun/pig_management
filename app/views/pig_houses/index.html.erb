<div class="pig-house-list-background">
 <div class="pig-house-page"> 
  <h1>豚舎一覧</h1>

  <%= link_to "新規登録", "/pig_houses/new" %>

  <% if alert %>
    <p class="delete-error"><%= alert %></p>
  <% end %>

 <% if @pig_houses.any? %>
  <% @pig_houses.each do |pig_house| %>
    
    <div class="pig-house-actions">
     <span><%= pig_house.name %></span>

     <%= link_to "編集", edit_pig_house_path(pig_house) %>

     <%= button_to "削除",
    delete_pig_house_path(pig_house),
    method: :delete,
    data: {
      turbo_confirm: "【注意】豚舎の削除は、不要になった場合のみ行ってください。本当に削除しますか？"
    } %>
    </div>  
   
  <% end %>
 <% else %>
  <p>まだ登録されていません。</p>
<% end %>

  <%= notice %> 
 </div>
</div>