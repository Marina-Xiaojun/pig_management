<div class="pig-house-list-background">
  <div class="pig-house-page">
    <h1>豚舎名の編集</h1>

    <% if @pig_house.errors.any? %>
      <ul class="error-messages">
        <% @pig_house.errors.each do |error| %>
          <p><%= error.message %></p>
        <% end %>
      </ul>
    <% end %>

    <%= form_with model: @pig_house, data: { turbo: false } do |form| %>
      <div class="destination-form">
        <%= form.label :name, "豚舎名" %>
        <%= form.text_field :name %>
        <%= form.submit "変更を保存" %>
      </div>
    <% end %>
  </div>
</div>
