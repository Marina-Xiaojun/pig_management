
<div class="login-page">
  <div class="login-box">

    <h1>ログイン</h1>

    <% if flash[:alert] %>
      <div class="error-messages">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: "/sessions", method: :post do |form| %>

      <div class="login-form">
        <div class="form-group">
          <%= form.label :employee_id, "従業員ID" %>
          <%= form.text_field :employee_id, placeholder: "従業員IDを入力" %>
        </div>

        <div class="form-group">
          <%= form.label :password, "パスワード" %>
          <%= form.password_field :password, placeholder: "パスワードを入力" %>
        </div>

        <%= form.submit "ログイン", class: "login-submit" %>
      </div>

    <% end %>

    <p class="register-link">
      従業員登録がお済みでない方は
      <a href="/employees/new">こちら</a>
    </p>

  </div>
</div>
